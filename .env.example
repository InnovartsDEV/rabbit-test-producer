# --- Publisher (copiar a .env y completar) ---

# Broker RabbitMQ (en el contenedor: nombre del servicio/contenedor de rabbit en la red compartida)
RABBITMQ_URI=amqp://USUARIO:PASSWORD@rabbitmq:5672

# Nombre de la red docker donde vive el contenedor de RabbitMQ (docker network ls)
RABBIT_NETWORK=rabbitmq_default

# Postgres del outbox (lo levanta este mismo compose)
POSTGRES_PASSWORD=cambia-esto

# Secreto compartido con el consumer de la NAS para descargar archivos (GET /archivos/:id)
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FILES_TOKEN=

# Puerto publicado en el host
PORT=3000

# Dias que se conservan los temporales cuya NAS nunca confirmo
TEMP_RETENTION_DAYS=7
